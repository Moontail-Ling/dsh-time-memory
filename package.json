{
  "name": "dsh-time-memory",
  "version": "0.1.0",
  "description": "按时间归档、分层回忆的聊天记忆插件；未命中扩大两次，仍没有就如实说「我忘记了」。Time-ordered chat memory with layered recall and honest forgetting.",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moontail-Ling/dsh-time-memory.git"
  },
  "homepage": "https://github.com/Moontail-Ling/dsh-time-memory#readme",
  "bugs": {
    "url": "https://github.com/Moontail-Ling/dsh-time-memory/issues"
  },
  "author": "Moontail-Ling",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "chat",
    "timeline"
  ],
  "license": "MIT"
}
