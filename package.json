{
  "name": "dsh-time-memory",
  "version": "0.1.0",
  "private": true,
  "description": "按时间归档、分层回忆的聊天记忆插件：先检索用户指认的时段，未命中自动扩大两次，仍无结果就回答「忘记了」。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "chat",
    "timeline"
  ],
  "license": "MIT"
}
